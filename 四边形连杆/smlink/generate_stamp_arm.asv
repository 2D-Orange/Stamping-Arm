clear;
clc;
close all;

%% ============================================================
%  generate_stamp_cartesian_ref_single.m
%
%  单文件版：参考坐标系笛卡尔插值轨迹生成程序
%
%  坐标定义：
%  1. 当前机械臂零位对应参考坐标系原点 [0 0 0]
%  2. x、y 为水平面方向
%  3. z 为竖直方向
%  4. 输入点格式：[x y z q4]
%
%  运行后生成：
%  q1_ts, q2_ts, q3_ts, q4_ts, T_end
%
%  运动流程：
%  零位 [0 0 0 0]
%  → 起始点 startRef
%  → 目标点 targetRef
%  → 目标点处 q4 收回
%  → 返回零位 [0 0 0 0]
%
%  核心特点：
%  本程序在参考坐标系中插值 x,y,z,q4，
%  然后每个采样点都重新计算 IK。
%% ============================================================


%% ============================================================
% 1. 模型名称，可选
%% ============================================================

modelName = 'stamp_arm';


%% ============================================================
% 2. 机械臂几何参数区
%
%  注意：
%  这些参数仍然是在“几何计算坐标系”下定义的。
%  如果你之前程序能正常运行，先不要乱改。
%% ============================================================

baseX = 0.0;
baseY = 0.0;

z0 = 0.120;       % 肩关节高度
r0 = 0.075;       % 底座旋转轴到肩关节的水平偏置

L2 = 0.250;       % 大臂等效长度
L3 = 0.300;       % 小臂等效长度


%% ============================================================
% 3. 已经调好的 Simscape 实际零位
%
%  当输入 q_home 时，机械臂应保持你现在调好的零位。
%% ============================================================

q1_home = deg2rad(9);
q2_home = deg2rad(0);
q3_home = deg2rad(180);
q4_home = 0.040;

q_home = [q1_home, q2_home, q3_home, q4_home];


%% ============================================================
% 4. 参考坐标系原点在几何坐标系中的位置
%
%  这是最关键的一项。
%
%  ref = [0 0 0] 时，实际对应几何坐标系中的 homeAbsXYZ。
%
%  换句话说：
%  homeAbsXYZ 是“机械臂零位时，腕部/印章滑块参考点”的绝对坐标。
%
%% ============================================================

homeAbsXYZ = [0.300, 0.000, 0.200];


%% ============================================================
% 5. 参考坐标系到几何坐标系的方向映射
%
%  默认：
%  参考 x = 几何 X
%  参考 y = 几何 Y
%  参考 z = 几何 Z
%
%  如果你发现方向反了，可以改这里。
%
%  例如：
%  参考 x 正方向和几何 X 负方向相反：
%  R_ref_to_geo = diag([-1, 1, 1]);
%
%  参考 x/y 交换：
%  R_ref_to_geo = [0 1 0;
%                  1 0 0;
%                  0 0 1];
%% ============================================================

R_ref_to_geo = [0 1 0;
                1 0 0;
                0 0 1];


%% ============================================================
% 6. 关节方向修正
%
%  如果某个关节正方向反了，把对应项从 1 改成 -1。
%
%  顺序：
%  [q1 底座, q2 大臂, q3 小臂, q4 印章下压]
%% ============================================================

jointSign = [1, -1, -1, -1];


%% ============================================================
% 7. IK 分支选择
%
%  如果小臂弯向相反侧，把 1 改成 -1。
%% ============================================================

elbowSign = 1;


%% ============================================================
% 8. 输入起始点和目标点
%
%  现在输入的是“参考坐标系”下的坐标。
%
%  参考坐标系定义：
%  零位印章参考点 = [0 0 0]
%  x,y 水平
%  z 竖直
%
%  点格式：
%  [x y z q4]
%% ============================================================

defaultStartRef  = [0.2, 0.1, 0, 0];
defaultTargetRef = [0, 0.1, -0.1, 0];

fprintf('\n========== 参考坐标系笛卡尔插值轨迹生成 ==========\n');
fprintf('当前机械臂零位定义为参考坐标系原点 [0 0 0]。\n');
fprintf('点格式：[x y z q4]\n');
fprintf('x,y 为水平位移，z 为竖直位移，单位 m；q4 为印章下压量，单位 m。\n\n');

fprintf('默认起始点：[%g %g %g %g]\n', defaultStartRef);
startRef = input('请输入起始点 [x y z q4]，直接回车使用默认值：');

if isempty(startRef)
    startRef = defaultStartRef;
end

fprintf('默认目标点：[%g %g %g %g]\n', defaultTargetRef);
targetRef = input('请输入目标点 [x y z q4]，直接回车使用默认值：');

if isempty(targetRef)
    targetRef = defaultTargetRef;
end

if numel(startRef) ~= 4 || numel(targetRef) ~= 4
    error('起始点和目标点都必须是 [x y z q4] 四个数。');
end

startRef = reshape(startRef, 1, 4);
targetRef = reshape(targetRef, 1, 4);


%% ============================================================
% 9. 时间参数
%% ============================================================

T_home_to_start   = 3.0;
T_start_to_target = 4.0;
T_retract         = 1.0;
T_return_home     = 3.0;

dt = 0.02;

segmentTimes = [
    T_home_to_start, ...
    T_start_to_target, ...
    T_retract, ...
    T_return_home
];


%% ============================================================
% 10. 构造参考坐标系中的任务点
%% ============================================================

homeRef = [0.000, 0.000, 0.000, 0.000];

retractRef = targetRef;
retractRef(4) = 0.000;

cartRefPoints = [
    homeRef;
    startRef;
    targetRef;
    retractRef;
    homeRef
];

taskNames = [
    "home";
    "start";
    "target";
    "retract";
    "home_return"
];


%% ============================================================
% 11. 计算几何 Home 的理论 IK
%
%  homeRef = [0 0 0 0]
%  对应的绝对几何坐标为：
%  homeAbsXYZ
%% ============================================================

homeAbsPoint = [homeAbsXYZ, 0.000];

q_geo_home = inverse_kinematics_geo( ...
    homeAbsPoint, baseX, baseY, z0, r0, L2, L3, elbowSign);


%% ============================================================
% 12. 打印任务点的绝对坐标与关节角
%% ============================================================

fprintf('\n========== 任务点检查 ==========\n');

Q_key = zeros(size(cartRefPoints,1), 4);
absPoints = zeros(size(cartRefPoints,1), 4);

for i = 1:size(cartRefPoints,1)

    absPoint = ref_point_to_abs_point( ...
        cartRefPoints(i,:), homeAbsXYZ, R_ref_to_geo);

    q_cmd = inverse_kinematics_cmd( ...
        absPoint, q_home, q_geo_home, jointSign, ...
        baseX, baseY, z0, r0, L2, L3, elbowSign);

    absPoints(i,:) = absPoint;
    Q_key(i,:) = q_cmd;

    fprintf('%-12s ref = [% .4f % .4f % .4f % .4f], abs = [% .4f % .4f % .4f % .4f]\n', ...
        taskNames(i), ...
        cartRefPoints(i,1), cartRefPoints(i,2), cartRefPoints(i,3), cartRefPoints(i,4), ...
        absPoint(1), absPoint(2), absPoint(3), absPoint(4));

    fprintf('             q = [% .3f deg, % .3f deg, % .3f deg, % .3f mm]\n', ...
        rad2deg(q_cmd(1)), rad2deg(q_cmd(2)), rad2deg(q_cmd(3)), 1000*q_cmd(4));
end


%% ============================================================
% 13. 参考坐标系中做笛卡尔插值，每个采样点重新 IK
%% ============================================================

[time, Q, P_ref, P_abs] = build_cartesian_ref_ik_trajectory( ...
    cartRefPoints, segmentTimes, dt, ...
    homeAbsXYZ, R_ref_to_geo, ...
    q_home, q_geo_home, jointSign, ...
    baseX, baseY, z0, r0, L2, L3, elbowSign);

T_end = time(end);


%% ============================================================
% 14. 生成 Simulink 需要的 timeseries
%% ============================================================

q1_ts = timeseries(Q(:,1), time);
q2_ts = timeseries(Q(:,2), time);
q3_ts = timeseries(Q(:,3), time);
q4_ts = timeseries(Q(:,4), time);

assignin('base', 'q1_ts', q1_ts);
assignin('base', 'q2_ts', q2_ts);
assignin('base', 'q3_ts', q3_ts);
assignin('base', 'q4_ts', q4_ts);
assignin('base', 'T_end', T_end);

assignin('base', 'time', time);
assignin('base', 'Q', Q);
assignin('base', 'P_ref', P_ref);
assignin('base', 'P_abs', P_abs);
assignin('base', 'cartRefPoints', cartRefPoints);
assignin('base', 'absPoints', absPoints);
assignin('base', 'Q_key', Q_key);
assignin('base', 'q_home', q_home);
assignin('base', 'homeAbsXYZ', homeAbsXYZ);

fprintf('\n已生成 q1_ts, q2_ts, q3_ts, q4_ts, T_end。\n');
fprintf('T_end = %.3f s\n', T_end);
fprintf('现在回到 Simulink，按 Ctrl+D 更新模型，然后点击 Run。\n');


%% ============================================================
% 15. 如果模型已打开，自动设置 StopTime
%% ============================================================

if bdIsLoaded(modelName)
    set_param(modelName, 'StopTime', 'T_end');
    set_param(modelName, 'SimulationCommand', 'update');
    fprintf('已自动更新模型 %s，并将 StopTime 设置为 T_end。\n', modelName);
end


%% ============================================================
% 16. 绘制关节轨迹
%% ============================================================

figure('Name','关节输入轨迹','Color','w');

subplot(4,1,1);
plot(time, rad2deg(Q(:,1)), 'LineWidth', 1.4);
grid on;
ylabel('q_1 / deg');

subplot(4,1,2);
plot(time, rad2deg(Q(:,2)), 'LineWidth', 1.4);
grid on;
ylabel('q_2 / deg');

subplot(4,1,3);
plot(time, rad2deg(Q(:,3)), 'LineWidth', 1.4);
grid on;
ylabel('q_3 / deg');

subplot(4,1,4);
plot(time, 1000*Q(:,4), 'LineWidth', 1.4);
grid on;
ylabel('q_4 / mm');
xlabel('Time / s');

sgtitle('由笛卡尔参考轨迹逐点 IK 得到的关节轨迹');


%% ============================================================
% 17. 保存数据
%% ============================================================

save('stamp_cartesian_ref_generated.mat', ...
    'q1_ts', 'q2_ts', 'q3_ts', 'q4_ts', 'T_end', ...
    'time', 'Q', 'P_ref', 'P_abs', ...
    'cartRefPoints', 'absPoints', 'Q_key', ...
    'q_home', 'homeAbsXYZ', 'R_ref_to_geo');

disp('已保存 stamp_cartesian_ref_generated.mat。');


%% ============================================================
%  局部函数区
%% ============================================================

function absPoint = ref_point_to_abs_point(refPoint, homeAbsXYZ, R_ref_to_geo)

    refXYZ = refPoint(1:3);
    q4 = refPoint(4);

    absXYZ = homeAbsXYZ + (R_ref_to_geo * refXYZ')';

    absPoint = [absXYZ, q4];

end


function q_cmd = inverse_kinematics_cmd(point, q_home, q_geo_home, jointSign, ...
    baseX, baseY, z0, r0, L2, L3, elbowSign)

    q_geo = inverse_kinematics_geo(point, baseX, baseY, z0, r0, L2, L3, elbowSign);

    q_cmd = q_home + jointSign .* (q_geo - q_geo_home);

end


function q_geo = inverse_kinematics_geo(point, baseX, baseY, z0, r0, L2, L3, elbowSign)

    x = point(1);
    y = point(2);
    z = point(3);
    q4 = point(4);

    q1 = atan2(y - baseY, x - baseX);

    rho = hypot(x - baseX, y - baseY);
    r = rho - r0;
    h = z - z0;

    D = (r^2 + h^2 - L2^2 - L3^2) / (2*L2*L3);

    if D > 1 || D < -1
        error(['目标点 abs = [%.4f %.4f %.4f %.4f] 超出工作空间：D = %.6f。\n' ...
               '请减小参考坐标位移，或检查 L2、L3、z0、r0、homeAbsXYZ。'], ...
               x, y, z, q4, D);
    end

    D = max(-1, min(1, D));

    q3 = atan2(elbowSign * sqrt(1 - D^2), D);

    q2 = atan2(h, r) - atan2(L3*sin(q3), L2 + L3*cos(q3));

    q_geo = [q1, q2, q3, q4];

end


function [timeAll, QAll, PRefAll, PAbsAll] = build_cartesian_ref_ik_trajectory( ...
    cartRefPoints, segmentTimes, dt, ...
    homeAbsXYZ, R_ref_to_geo, ...
    q_home, q_geo_home, jointSign, ...
    baseX, baseY, z0, r0, L2, L3, elbowSign)

    if size(cartRefPoints,1) - 1 ~= numel(segmentTimes)
        error('segmentTimes 数量必须等于 cartRefPoints 行数减 1。');
    end

    timeAll = [];
    QAll = [];
    PRefAll = [];
    PAbsAll = [];

    currentTime = 0;

    for k = 1:size(cartRefPoints,1)-1

        p0 = cartRefPoints(k,:);
        pf = cartRefPoints(k+1,:);
        T = segmentTimes(k);

        t = (0:dt:T)';

        if t(end) < T
            t = [t; T];
        end

        tau = t / T;

        s = 10*tau.^3 - 15*tau.^4 + 6*tau.^5;

        PRefSeg = p0 + s .* (pf - p0);

        Qseg = zeros(length(t),4);
        PAbsSeg = zeros(length(t),4);

        for i = 1:length(t)

            absPoint = ref_point_to_abs_point( ...
                PRefSeg(i,:), homeAbsXYZ, R_ref_to_geo);

            q_cmd = inverse_kinematics_cmd( ...
                absPoint, q_home, q_geo_home, jointSign, ...
                baseX, baseY, z0, r0, L2, L3, elbowSign);

            PAbsSeg(i,:) = absPoint;
            Qseg(i,:) = q_cmd;
        end

        if k > 1
            t = t(2:end);
            PRefSeg = PRefSeg(2:end,:);
            PAbsSeg = PAbsSeg(2:end,:);
            Qseg = Qseg(2:end,:);
        end

        timeAll = [timeAll; currentTime + t]; %#ok<AGROW>
        PRefAll = [PRefAll; PRefSeg]; %#ok<AGROW>
        PAbsAll = [PAbsAll; PAbsSeg]; %#ok<AGROW>
        QAll = [QAll; Qseg]; %#ok<AGROW>

        currentTime = currentTime + T;
    end

end